# Environment & Server Port
NODE_ENV=production
PORT=5000

# PostgreSQL Database Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/taskboard_db?schema=public"

# JWT Authentication Secret & Expiry
JWT_SECRET="your-super-secret-jwt-key-replace-in-production"
JWT_EXPIRES_IN="7d"

# CORS & Frontend Origins
FRONTEND_URL="https://taskboard.io"
CORS_ORIGIN="https://taskboard.io"

# Rate Limiting (100 requests per 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Google OAuth (Optional)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="https://api.taskboard.io/api/v1/auth/google/callback"
